@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# what the headers of c_ares_async include
find_dependency(Boost @C_ARES_ASYNC_BOOST_VERSION@)
find_dependency(c-ares @C_ARES_ASYNC_CARES_VERSION@ CONFIG)

#
# A static library does not carry its own dependencies, so linking it means linking them too. A
# shared one has them resolved already.
#
set(c_ares_async_TLS "@C_ARES_ASYNC_TLS@")

if ("@c_ares_async_type@" STREQUAL "STATIC_LIBRARY")
    find_dependency(Threads)

    if (c_ares_async_TLS STREQUAL "OpenSSL")
        find_dependency(OpenSSL @C_ARES_ASYNC_OPENSSL_VERSION@)
    else()
        find_dependency(ssl CONFIG) # AWS-LC, ssl_ROOT says where
    endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/c_ares_async-targets.cmake")

check_required_components(c_ares_async)
