//
// Generated from cmake/version.hpp.in, where project() in CMakeLists.txt has the numbers.
//
#pragma once

#define C_ARES_ASYNC_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define C_ARES_ASYNC_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define C_ARES_ASYNC_VERSION_PATCH @PROJECT_VERSION_PATCH@

// "major.minor.patch"
#define C_ARES_ASYNC_VERSION_STRING "@PROJECT_VERSION@"

// major * 10000 + minor * 100 + patch, for comparing in the preprocessor
#define C_ARES_ASYNC_VERSION                                                                       \
   (C_ARES_ASYNC_VERSION_MAJOR * 10000 + C_ARES_ASYNC_VERSION_MINOR * 100 +                        \
    C_ARES_ASYNC_VERSION_PATCH)
