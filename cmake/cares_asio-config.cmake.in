@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# what the headers of cares_asio include
find_dependency(Boost @CARES_ASIO_BOOST_VERSION@)
find_dependency(c-ares @CARES_ASIO_CARES_VERSION@ CONFIG)

#
# A static library does not carry its own dependencies, so linking it means linking them too. A
# shared one has them resolved already.
#
set(cares_asio_TLS "@CARES_ASIO_TLS@")

if ("@cares_asio_type@" STREQUAL "STATIC_LIBRARY")
    find_dependency(Threads)

    if (cares_asio_TLS STREQUAL "OpenSSL")
        find_dependency(OpenSSL @CARES_ASIO_OPENSSL_VERSION@)
    else()
        find_dependency(ssl CONFIG) # AWS-LC, ssl_ROOT says where
    endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/cares_asio-targets.cmake")

check_required_components(cares_asio)
