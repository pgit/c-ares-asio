@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# what the headers of cares_async include
find_dependency(Boost @CARES_ASYNC_BOOST_VERSION@)
find_dependency(c-ares @CARES_ASYNC_CARES_VERSION@ CONFIG)

#
# A static library does not carry its own dependencies, so linking it means linking them too. A
# shared one has them resolved already.
#
set(cares_async_TLS "@CARES_ASYNC_TLS@")

if ("@cares_async_type@" STREQUAL "STATIC_LIBRARY")
    find_dependency(Threads)

    if (cares_async_TLS STREQUAL "OpenSSL")
        find_dependency(OpenSSL @CARES_ASYNC_OPENSSL_VERSION@)
    else()
        find_dependency(ssl CONFIG) # AWS-LC, ssl_ROOT says where
    endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/cares_async-targets.cmake")

check_required_components(cares_async)
